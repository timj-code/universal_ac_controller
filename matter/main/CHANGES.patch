+static void app_driver_led_brightness(float level)
+{
+    if (!s_led_pwm_ready) return;
+    level = std::max(0.0f, std::min(1.0f, level));
+    // GPIO8 on the SUPER MINI is active LOW; 0% PWM duty means ON.
+    const float duty_fraction = SUPER_MINI_LED_ACTIVE_LOW ? (1.0f - level) : level;
+    const uint32_t duty = static_cast<uint32_t>(duty_fraction * LED_PWM_MAX_DUTY);
+    if (ledc_set_duty(LED_PWM_MODE, LED_PWM_CHANNEL, duty) == ESP_OK) {
+        ledc_update_duty(LED_PWM_MODE, LED_PWM_CHANNEL);
+    }
+}

+/*
+ * HDC2010 environment monitor. Hardware matches the ESPHome 1.7.2 design:
+ * SDA=GPIO7, SCL=GPIO2, 100 kHz, 7-bit address 0x40.
+ * A FreeRTOS task reads the sensor every 2 seconds. Only the Matter thread
+ * updates attributes; the worker never calls attribute::report directly.
+ */
+static constexpr gpio_num_t HDC2010_SDA = GPIO_NUM_7;
+static constexpr gpio_num_t HDC2010_SCL = GPIO_NUM_2;
+static constexpr uint16_t HDC2010_ADDRESS = 0x40;
+static constexpr int HDC2010_SAMPLE_PERIOD_MS = 2000;
+static i2c_master_bus_handle_t s_hdc2010_bus = nullptr;
+static i2c_master_dev_handle_t s_hdc2010_dev = nullptr;
+static TaskHandle_t s_hdc2010_task = nullptr;
+static std::atomic<int16_t> s_hdc2010_temp_x100{0};
+static std::atomic<uint16_t> s_hdc2010_rh_x100{0};
+static std::atomic_bool s_hdc2010_valid{false};
+
+static esp_err_t app_driver_hdc2010_read_reg(uint8_t reg, uint8_t *dst, size_t size)
+{
+    return i2c_master_transmit_receive(s_hdc2010_dev, &reg, 1, dst, size, 100);
+}
+
+static esp_err_t app_driver_hdc2010_initialize()
+{
+    i2c_master_bus_config_t bus{};
+    bus.i2c_port = I2C_NUM_0;
+    bus.sda_io_num = HDC2010_SDA;
+    bus.scl_io_num = HDC2010_SCL;
+    bus.clk_source = I2C_CLK_SRC_DEFAULT;
+    bus.glitch_ignore_cnt = 7;
+    bus.flags.enable_internal_pullup = true;
+
+    esp_err_t err = i2c_new_master_bus(&bus, &s_hdc2010_bus);
+    if (err != ESP_OK) return err;
+
+    i2c_device_config_t dev{};
+    dev.dev_addr_length = I2C_ADDR_BIT_LEN_7;
+    dev.device_address = HDC2010_ADDRESS;
+    dev.scl_speed_hz = 100000;
+    err = i2c_master_bus_add_device(s_hdc2010_bus, &dev, &s_hdc2010_dev);
+    if (err != ESP_OK) return err;
+
+    uint8_t id[2]{};
+    err = app_driver_hdc2010_read_reg(0xFE, id, sizeof(id));
+    if (err != ESP_OK) return err;
+    const uint16_t device_id = static_cast<uint16_t>(id[0]) |
+                                (static_cast<uint16_t>(id[1]) << 8);
+    if (device_id != 0x07D0) {
+        ESP_LOGE(TAG, "HDC2010 unexpected device ID: 0x%04X", device_id);
+        return ESP_ERR_NOT_FOUND;
+    }
+    ESP_LOGI(TAG, "HDC2010 ready: address=0x40 SDA=7 SCL=2 ID=0x%04X", device_id);
+    return ESP_OK;
+}
+
+static esp_err_t app_driver_hdc2010_measure(int16_t &temperature_x100, uint16_t &humidity_x100)
+{
+    // Register 0x0F: MEAS_CONF=00 (temperature+humidity), TRIG=1.
+    const uint8_t trigger[] = {0x0F, 0x01};
+    esp_err_t err = i2c_master_transmit(s_hdc2010_dev, trigger, sizeof(trigger), 100);
+    if (err != ESP_OK) return err;
+    vTaskDelay(pdMS_TO_TICKS(20));
+
+    // Registers 0x00..0x03: temperature L/H, humidity L/H.
+    uint8_t bytes[4]{};
+    err = app_driver_hdc2010_read_reg(0x00, bytes, sizeof(bytes));
+    if (err != ESP_OK) return err;
+    const uint16_t raw_temp = static_cast<uint16_t>(bytes[0]) |
+                              (static_cast<uint16_t>(bytes[1]) << 8);
+    const uint16_t raw_rh = static_cast<uint16_t>(bytes[2]) |
+                            (static_cast<uint16_t>(bytes[3]) << 8);
+    // TI conversion: T (°C) = raw * 165 / 65536 - 40; RH (%) = raw * 100 / 65536.
+    const float t = static_cast<float>(raw_temp) * 165.0f / 65536.0f - 40.0f;
+    const float rh = static_cast<float>(raw_rh) * 100.0f / 65536.0f;
+    if (t < -40.0f || t > 125.0f || rh < 0.0f || rh > 100.0f) {
+        return ESP_ERR_INVALID_RESPONSE;
+    }
+    temperature_x100 = static_cast<int16_t>(std::lround(t * 100.0f));
+    humidity_x100 = static_cast<uint16_t>(std::lround(rh * 100.0f));
+    return ESP_OK;
+}
+
+static void app_driver_hdc2010_report_on_matter_thread(intptr_t arg)
+{
+    (void)arg;
+    if (!s_hdc2010_valid.load() || room_air_conditioner_endpoint_id == 0) return;
+    const int16_t temperature = s_hdc2010_temp_x100.load();
+    const uint16_t humidity = s_hdc2010_rh_x100.load();
+
+    // Unlike setpoints, local temperature must remain the actual room reading.
+    app_matter_update_display_temperature(temperature);
+
+#if BC7215_HUMIDITY_CODE_DRIVEN
+    // Modern esp-matter stores RelativeHumidityMeasurement in a code-driven
+    // cluster rather than the legacy attribute cache; this method updates
+    // the real cluster and triggers subscriptions.
+    CHIP_ERROR chip_err = chip::app::Clusters::RelativeHumidityMeasurement::SetMeasuredValue(
+        room_air_conditioner_endpoint_id,
+        chip::app::DataModel::MakeNullable<uint16_t>(humidity));
+    if (chip_err != CHIP_NO_ERROR) {
+        ESP_LOGE(TAG, "Humidity code-driven update failed: %" CHIP_ERROR_FORMAT, chip_err.Format());
+    }
+#else
+    // Legacy ESP-Matter data model path (e.g. release/v1.4.x).
+    esp_matter_attr_val_t value = esp_matter_nullable_uint16(nullable<uint16_t>(humidity));
+    esp_err_t err = attribute::report(
+        room_air_conditioner_endpoint_id,
+        RelativeHumidityMeasurement::Id,
+        RelativeHumidityMeasurement::Attributes::MeasuredValue::Id,
+        &value);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Humidity report failed: %s", esp_err_to_name(err));
+    }
+#endif
+    ESP_LOGI(TAG, "HDC2010: %.2f C, %.2f %%RH", temperature / 100.0f, humidity / 100.0f);
+}
+
+static void app_driver_hdc2010_task(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        int16_t t = 0;
+        uint16_t h = 0;
+        const esp_err_t err = app_driver_hdc2010_measure(t, h);
+        if (err == ESP_OK) {
+            s_hdc2010_temp_x100.store(t);
+            s_hdc2010_rh_x100.store(h);
+            s_hdc2010_valid.store(true);
+            CHIP_ERROR schedule_err = chip::DeviceLayer::PlatformMgr().ScheduleWork(
+                app_driver_hdc2010_report_on_matter_thread, 0);
+            if (schedule_err != CHIP_NO_ERROR) {
+                ESP_LOGE(TAG, "Could not schedule HDC2010 report: %" CHIP_ERROR_FORMAT,
+                         schedule_err.Format());
+            }
+        } else {
+            ESP_LOGW(TAG, "HDC2010 measurement failed: %s", esp_err_to_name(err));
+        }
+        vTaskDelay(pdMS_TO_TICKS(HDC2010_SAMPLE_PERIOD_MS));
+    }
+}
+
+esp_err_t app_driver_environment_sensor_start()
+{
+    if (s_hdc2010_task) return ESP_OK;
+    esp_err_t err = app_driver_hdc2010_initialize();
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "HDC2010 initialization failed: %s", esp_err_to_name(err));
+        return err;
+    }
+    if (xTaskCreate(app_driver_hdc2010_task, "hdc2010", 4096, nullptr, 4,
+                    &s_hdc2010_task) != pdPASS) {
+        ESP_LOGE(TAG, "Cannot create HDC2010 task");
+        return ESP_ERR_NO_MEM;
+    }
+    return ESP_OK;
+}
 
